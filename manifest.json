{
  "id": "/",
  "name": "trade.log",
  "short_name": "trade.log",
  "description": "Trading journal dashboard",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0a0b0f",
  "theme_color": "#0a0b0f",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "csv",
          "accept": [
            "text/csv",
            "text/comma-separated-values",
            "application/csv",
            "application/vnd.ms-excel",
            ".csv"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Trade note",
      "short_name": "Trade note",
      "description": "Jot a note or tags on a trade right after it closes",
      "url": "/?quick=trade",
      "icons": [
        {
          "src": "icons/shortcut-trade-note.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Day note",
      "short_name": "Day note",
      "description": "Add a thought for today",
      "url": "/?quick=note",
      "icons": [
        {
          "src": "icons/shortcut-day-note.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Journal",
      "url": "/journal.html",
      "icons": [
        {
          "src": "icons/shortcut-journal.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Daily plan",
      "url": "/daily.html",
      "icons": [
        {
          "src": "icons/shortcut-daily-plan.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Performance",
      "url": "/stats.html"
    },
    {
      "name": "Calculator",
      "url": "/calculator.html"
    }
  ]
}
