ce is more than 10% above the VWAP of 6.80 without an established consolidation range.","lessons":[{"lesson":"Avoid chasing momentum when price is too far extended above the EMA9 of 6.57 and VWAP of 6.80.","how_to_know":"Calculate the spread between current price 7.25 and VWAP 6.80; if it exceeds 5-6%, do not chase.","tag":"chased_extension"},{"lesson":"Maintain strict adherence to predefined stop losses instead of taking arbitrary early exits like 7.16.","how_to_know":"Set a hard stop order at the EMA20 level of 6.36 and let it work rather than manually bailing out.","tag":"no_stop_discipline"}],"symbol_info":{"name":"Defense Metals Corp.","country":"Canada","sector":"Basic Materials","description":"Defense Metals Corp. is a mineral exploration and development company focused on the acquisition and development of rare earth element deposits. Its flagship asset is the Wicheeda Rare Earth Element Project located in British Columbia, Canada."},"indicators":{"avg_volume_30d":35029738.3,"avg_volume_tag":"avgvol_20m_plus","display_price_high":7.4,"display_price_low":5.86,"ema20_at_entry":6.3633,"ema9_at_entry":6.5724,"entry_price":7.25,"entry_time":"2026-07-27T07:08:06","entry_vs_ema20":"above","entry_vs_ema9":"above","entry_vs_vwap":"above","exit_price":7.16,"exit_time":"2026-07-27T07:08:20","float_shares":1663806,"float_tag":"float_micro_under_10m","macd_at_entry":0.1798,"macd_hist_at_entry":0.0933,"macd_hist_prior_bar":0.1067,"macd_signal_at_entry":0.0865,"r_multiple":2,"relative_volume":2.251,"reward_per_share":2.932,"risk_per_share":1.466,"rvol_tag":"rvol_2x_5x","setup_type":"other","stop_price":5.784,"target_price":10.182,"volume_on_entry_day":78865711,"vwap_at_entry":6.8002},"bars":[{"c":6.14,"ema20":6.2012,"ema9":6.1995,"h":6.26,"l":6.14,"macd":0.0039,"macd_hist":-0.0054,"macd_signal":0.0093,"o":6.24,"t":"2026-07-27T05:39:00","v":6798,"vwap":6.9889},{"c":6.1779,"ema20":6.199,"ema9":6.1952,"h":6.1859,"l":6.14,"macd":0.0017,"macd_hist":-0.006,"macd_signal":0.0078,"