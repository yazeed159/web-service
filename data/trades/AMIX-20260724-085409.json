.3,"risk_reward":"1:2.88","walk_away_rule":"Walk away and do not enter any long trade if price is more than 5% above the VWAP of 4.56 without a confirmed 1-minute consolidation base.","lessons":[{"lesson":"Avoid chasing parabolic momentum when price is stretched far above the VWAP of 4.56 and EMA9 of 4.19.","how_to_know":"Calculate the distance from VWAP: if entry price 5.04 is more than 8% above VWAP 4.56, withhold the buy order.","tag":"chased_extension"},{"lesson":"Ensure entries are based on structured pullbacks to key moving averages rather than FOMO market orders near the highs.","how_to_know":"Verify that the 1-minute candle has touched and bounced off the EMA9 at 4.19 before executing a long entry.","tag":"entered_against_trend"}],"symbol_info":{"name":"Apollo Medical Holdings Inc","country":"United States","sector":"Healthcare","description":"A healthcare management company operating an integrated delivery system that provides clinical medical services, hospitalist care, and administrative support to physicians and medical groups."},"indicators":{"avg_volume_30d":231661.5,"avg_volume_tag":"avgvol_under_500k","display_price_high":5.3,"display_price_low":3.39,"ema20_at_entry":3.9085,"ema9_at_entry":4.1891,"entry_price":5.04,"entry_time":"2026-07-24T08:54:09","entry_vs_ema20":"above","entry_vs_ema9":"above","entry_vs_vwap":"above","exit_price":4.72,"exit_time":"2026-07-24T08:54:22","float_shares":971043,"float_tag":"float_micro_under_10m","macd_at_entry":0.2395,"macd_hist_at_entry":0.1317,"macd_hist_prior_bar":0.1211,"macd_signal_at_entry":0.1077,"r_multiple":2,"relative_volume":34.634,"reward_per_share":3.449,"risk_per_share":1.7245,"rvol_tag":"rvol_10x_plus","setup_type":"other","stop_price":3.3155,"target_price":8.489,"volume_on_entry_day":8023302,"vwap_at_entry":4.5648},"bars":[{"c":3.4246,"ema20":3.4261,"ema9":3.4246,"h":3.4246,"l":3.4246,"macd":-0.0047,"macd_hist":0.0021,"macd_signal":-0.0068,"o":3.4246,"t":"2026-07-24T07:25:00","v":0,"vwap":3.5412},{"c"