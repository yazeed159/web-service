":12.5,"risk_reward":"1:2","walk_away_rule":"Walk away and do not chase if price is more than 5 percent above EMA20 at 10.94 without a proper 1-minute consolidation pullback.","lessons":[{"lesson":"Avoid chasing price at 11.43 when it is excessively extended above the EMA20 value of 10.94.","how_to_know":"Compare current price to EMA20 at 10.94; if the gap exceeds 5 percent without a pullback, do not enter.","tag":"chased_extension"},{"lesson":"Ensure MACD histogram is expanding rather than contracting (0.1202 down from 0.1657) before taking a momentum trade.","how_to_know":"Check the MACD histogram value on the current bar; if it is lower than the prior bar's 0.1657, momentum is fading.","tag":"ignored_volume"}],"symbol_info":{"name":"Cleantech Lithium PLC","country":"United Kingdom","sector":"Basic Materials","description":"Cleantech Lithium PLC is an exploration and development company advancing sustainable lithium projects in Chile. The company utilizes direct lithium extraction (DLE) technology to produce battery-grade lithium with a lower environmental footprint for the electric vehicle market."},"indicators":{"avg_volume_30d":6774646.8,"avg_volume_tag":"avgvol_5m_20m","display_price_high":13.13,"display_price_low":9.62,"ema20_at_entry":10.9362,"ema9_at_entry":11.2963,"entry_price":11.43,"entry_time":"2026-08-06T08:46:46","entry_vs_ema20":"above","entry_vs_ema9":"above","entry_vs_vwap":"above","exit_price":11.26,"exit_time":"2026-08-06T08:47:10","float_shares":2675412,"float_tag":"float_micro_under_10m","macd_at_entry":0.3328,"macd_hist_at_entry":0.1202,"macd_hist_prior_bar":0.1657,"macd_signal_at_entry":0.2126,"r_multiple":2,"relative_volume":10.251,"reward_per_share":3.898,"risk_per_share":1.949,"rvol_tag":"rvol_10x_plus","setup_type":"other","stop_price":9.481,"target_price":15.328,"volume_on_entry_day":69447606,"vwap_at_entry":10.2205},"bars":[{"c":11.63,"ema20":9.8417,"ema9":10.7141,"h":11.66,"l":11.17,"macd":0.9754,"macd_hist":0.1163,"macd_signal":0.8592