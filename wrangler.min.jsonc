{
  // Same worker as wrangler.jsonc, but serving the minified ./dist folder (see scripts/build-min.mjs).
  // Used only by `npm run deploy:min`. Your normal deploy keeps using wrangler.jsonc.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web-service",
  "compatibility_date": "2026-09-18",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist"
  }
}
